# Shared resource fragments. Every application schema imports this file.
# Nothing runs from this directory, so this file declares no `@currentEnv`.
#
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# --- PostgreSQL -------------------------------------------------------------

# Medusa test-utils turns TLS on unless the connection string it builds contains
# this literal. The worktree PostgreSQL service serves no TLS.
DB_HOST=localhost

DB_USERNAME=postgres

# `mze` discovers this from Compose and injects it. It carries no default on
# purpose: a default would let a renamed injection key fall back to 5432 and
# reach a different database than the one the worktree started.
# @required @type=string(matches=/^[0-9]+$/)
DB_PORT=

# The composed URL carries this value raw, so reject anything that would need
# percent-encoding rather than build a malformed URL.
# @required @sensitive @type=string(matches=/^[A-Za-z0-9._~-]+$/)
DB_PASSWORD=

# @required @type=url
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/mze-store?sslmode=disable

# --- Redis ------------------------------------------------------------------

# Separate from DB_HOST. Under Compose the two services answer to their own
# names, so Redis and PostgreSQL do not share a host.
REDIS_HOST=localhost

# Backs caching, the event bus, the workflow engine, locking, and the admin
# session store. See docs/adr/0006-redis-from-the-first-deploy.md.
# @required @type=string(matches=/^[0-9]+$/)
REDIS_PORT=

# Which logical Redis database. `medusa develop` holds its state in 0, so the
# integration suite uses another and flushes only that one. See
# apps/medusa/.env.test.
# @type=string(matches=/^[0-9]+$/)
REDIS_DB=0

# @required @type=url
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
