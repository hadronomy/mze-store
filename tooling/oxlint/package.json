{
  "name": "@mze-store/oxlint",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./rules": {
      "types": "./dist/rules.d.mts",
      "import": "./dist/rules.mjs",
      "default": "./dist/rules.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check-types": "vp run build && tsc --noEmit",
    "test": "vp run build && vp test --dir test"
  },
  "dependencies": {
    "@oxlint/plugins": "1.78.0",
    "effect": "4.0.0-beta.107",
    "effect-oxlint": "github:hadronomy/effect-oxlint#ef3bfa2",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.107",
    "@mze-store/config": "workspace:*",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
