{
  "name": "@mze-store/oxlint",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./rules": {
      "types": "./dist/rules.d.mts",
      "import": "./dist/rules.mjs",
      "default": "./dist/rules.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vp run build && vp test --dir test"
  },
  "dependencies": {
    "@oxlint/plugins": "1.78.0",
    "effect": "4.0.0-rc.109",
    "effect-oxlint": "https://github.com/hadronomy/effect-oxlint/archive/ef3bfa21d55db6227391720ce52726bfc116f32f.tar.gz",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@mze-store/config": "workspace:*",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
