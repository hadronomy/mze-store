{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mze-store/config/tsconfig.esm.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["anti-slop/**/*.ts", "src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "exclude": ["dist"]
}
