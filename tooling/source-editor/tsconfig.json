{
  "extends": "@mze-store/config/tsconfig.esm.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024"],
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "vscode"]
  },
  "exclude": ["dist", "vite.config.ts"]
}
