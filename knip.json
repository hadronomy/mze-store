{
  "$schema": "https://unpkg.com/knip@6.32.1/schema.json",
  "ignore": [
    "**/.medusa/**",
    "**/.output/**",
    "**/.tanstack/**",
    "**/.vinxi/**",
    "**/dist/**",
    "packages/db/drizzle.config.ts",
    "apps/storefront/src/routeTree.gen.ts"
  ],
  "ignoreDependencies": ["@axe-core/playwright", "rolldown", "uuid"],
  "ignoreBinaries": ["auth", "drizzle-kit", "jest", "medusa", "portless", "tsc", "tsc-alias", "vp"],
  "workspaces": {
    ".": {
      "entry": ["vite.config.ts", "tooling/**/*.ts", "e2e/**/*.ts"],
      "project": ["tooling/**/*.ts", "e2e/**/*.ts"]
    },
    "apps/medusa": {
      "entry": [
        "medusa-config.ts",
        "jest.config.js",
        "src/**/*.ts",
        "integration-tests/**/*.{js,ts}"
      ],
      "project": ["*.{js,ts}", "src/**/*.ts", "integration-tests/**/*.{js,ts}"],
      "ignoreDependencies": [
        "@medusajs/admin-sdk",
        "@medusajs/admin-shared",
        "@medusajs/dashboard",
        "@medusajs/draft-order",
        "ts-node",
        "vite"
      ]
    },
    "apps/storefront": {
      "entry": ["vite.config.ts", "nitro.config.ts", "src/**/*.{ts,tsx}"],
      "project": ["*.{ts,tsx}", "src/**/*.{ts,tsx}"]
    },
    "packages/auth": {
      "entry": ["auth.ts", "src/**/*.ts"],
      "project": ["*.ts", "src/**/*.ts"],
      "ignoreDependencies": ["@mze-store/env", "dotenv"]
    },
    "packages/config": {
      "entry": [],
      "project": []
    },
    "packages/db": {
      "drizzle": false,
      "entry": ["src/**/*.ts"],
      "project": ["*.ts", "src/**/*.ts"],
      "ignoreDependencies": ["@mze-store/env", "dotenv"]
    },
    "packages/env": {
      "entry": ["vite.config.ts", "src/**/*.ts", "test/**/*.ts"],
      "project": ["*.ts", "src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["postcss.config.mjs", "src/**/*.{ts,tsx}"],
      "project": ["*.mjs", "src/**/*.{ts,tsx}"]
    }
  }
}
