# Copy to `.env`. The defaults match the compose services in the repo root.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mze-store

# Backs caching, the event bus, the workflow engine, and locking, plus the admin
# session store. medusa-config.ts registers those four against Redis
# unconditionally and each throws without a URL, so the backend will not start
# until this is set — deliberately, per
# docs/adr/0006-redis-from-the-first-deploy.md.
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3001,http://localhost:9000

JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Use a Stripe secret key. The backend validates this value before it starts.
STRIPE_API_KEY=
