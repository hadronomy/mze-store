# Copy to `.env`. Replace the host ports after `bun run services:start` if
# Compose assigns random ports to this worktree.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mze-store

# Backs caching, the event bus, the workflow engine, and locking, plus the admin
# session store. The Medusa environment contract requires this value before it
# creates the config. See docs/adr/0006-redis-from-the-first-deploy.md.
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3001,http://localhost:9000
# The Portless development command replaces these three values with anchored
# HTTPS patterns for the named Storefront and Medusa URLs.

JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Use a Stripe secret key. The backend validates this value before it starts.
STRIPE_API_KEY=
