# Copy to `.env`. The defaults match the compose services in the repo root.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mze-store

# Backs caching, the event bus, the workflow engine, locking, and the admin
# session store. Medusa substitutes in-memory stand-ins for all five when it is
# missing, so the backend refuses to start without it — see
# docs/adr/0006-redis-from-the-first-deploy.md.
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3001,http://localhost:9000

JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
