# Committed on purpose, and loaded only when APP_ENV=test. These values support
# direct Jest runs. `mze test` replaces the ports with the ones for the current
# worktree.

# medusaIntegrationTestRunner creates and drops one database per jest worker, so
# it wants the connection in parts. The root schema composes DATABASE_URL from
# the same parts. The runner replaces that value with its worker database
# before the backend starts.
DB_PORT=5432
DB_PASSWORD=password

# Start it with `docker compose up -d redis`. health.spec.ts asserts against
# Redis directly, for the reason that ADR-0006 gives.
#
# Give the port only. integration-tests/setup.js adds the database index, one
# for each jest worker. An index here has no effect.
REDIS_PORT=6379

JWT_SECRET=test-jwt-secret
COOKIE_SECRET=test-cookie-secret

# The Stripe integration test routes this test-shaped key to local Emulate.
# Nock blocks any Stripe request that does not match that exact test bridge.
STRIPE_API_KEY=sk_test_integration
