# Committed on purpose. These are the repo's compose addresses, not secrets, and
# the integration runner has no other way to find Postgres and Redis.

# medusaIntegrationTestRunner creates and drops one database per jest worker, so
# it wants the connection in parts. DATABASE_URL is deliberately absent: the
# runner overwrites it after medusa-config.ts has loaded, so a value here would
# only ever mislead.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password

# Bring it up with `docker compose up -d redis`. health.spec.ts asserts against
# this directly, for the reason ADR-0006 exists.
#
# Database index 1, because the suite empties it before each run and index 0 is
# where a developer's own `medusa develop` keeps its in-flight workflows.
REDIS_URL=redis://localhost:6379/1

STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3001,http://localhost:9000
JWT_SECRET=test-jwt-secret
COOKIE_SECRET=test-cookie-secret
