# Committed on purpose. These are the repo's compose addresses, not secrets, and
# the integration runner has no other way to find Postgres and Redis. Everything
# else the backend reads — CORS, secrets — is left to Medusa's own development
# defaults, since nothing here exercises them.

# medusaIntegrationTestRunner creates and drops one database per jest worker, so
# it wants the connection in parts. DATABASE_URL is deliberately absent: the
# runner overwrites it after medusa-config.ts has loaded, so a value here would
# only ever mislead.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password

# Start it with `docker compose up -d redis`. health.spec.ts asserts against
# Redis directly, for the reason that ADR-0006 gives.
#
# Give the host and the port only. integration-tests/setup.js adds the database
# index, one for each jest worker. A database index here has no effect.
REDIS_URL=redis://localhost:6379

# The Stripe integration test routes this test-shaped key to local Emulate.
# Nock blocks any Stripe request that does not match that exact test bridge.
STRIPE_API_KEY=sk_test_integration
