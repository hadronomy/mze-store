# Committed on purpose. These are test values and local service addresses.

# medusaIntegrationTestRunner creates and drops one database per jest worker, so
# it wants the connection in parts. The shared environment schema still needs a
# complete URL while medusa-config.ts loads. The runner replaces that config
# value with its worker database before the backend starts.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mze-store
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password

STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3001,http://localhost:9000
JWT_SECRET=test-jwt-secret
COOKIE_SECRET=test-cookie-secret

# Start it with `docker compose up -d redis`. health.spec.ts asserts against
# Redis directly, for the reason that ADR-0006 gives.
#
# Give the host and the port only. integration-tests/setup.js adds the database
# index, one for each jest worker. A database index here has no effect.
REDIS_URL=redis://localhost:6379

# The Stripe integration test routes this test-shaped key to local Emulate.
# Nock blocks any Stripe request that does not match that exact test bridge.
STRIPE_API_KEY=sk_test_integration
