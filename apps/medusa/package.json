{
  "name": "medusa",
  "private": true,
  "scripts": {
    "build": "SKIP_ENV_VALIDATION=1 medusa build && tsc-alias -p tsconfig.json",
    "check-types": "SKIP_ENV_VALIDATION=1 medusa build",
    "db:migrate": "vp run --filter '@mze-store/env' --filter '@mze-store/territory' build && medusa db:migrate",
    "db:rollback": "vp run --filter '@mze-store/env' --filter '@mze-store/territory' build && medusa db:rollback",
    "dev": "vp run --filter '@mze-store/env' --filter '@mze-store/territory' build && vp run dev:raw",
    "dev:raw": "medusa develop",
    "seed": "vp run --filter '@mze-store/env' --filter '@mze-store/territory' build && medusa exec ./src/scripts/seed.ts",
    "seed:probe": "vp run --filter '@mze-store/env' --filter '@mze-store/territory' build && medusa exec ./src/scripts/seed-probe.ts",
    "start": "medusa start",
    "test": "vp run --filter '@mze-store/env' --filter '@mze-store/territory' build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "user:create": "vp run --filter '@mze-store/env' --filter '@mze-store/territory' build && medusa user"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "catalog:",
    "@medusajs/admin-shared": "catalog:",
    "@medusajs/cli": "catalog:",
    "@medusajs/dashboard": "catalog:",
    "@medusajs/draft-order": "catalog:",
    "@medusajs/framework": "catalog:",
    "@medusajs/medusa": "catalog:",
    "@medusajs/ui": "4.2.0",
    "@mze-store/env": "workspace:*",
    "@mze-store/territory": "workspace:*",
    "fast-json-stable-stringify": "^2.1.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "catalog:",
    "@mze-store/config": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "drizzle-orm": "^0.45.2",
    "emulate": "0.9.0",
    "ioredis": "catalog:",
    "jest": "^29.7.0",
    "nock": "13.5.6",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
