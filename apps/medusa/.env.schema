# Medusa backend contract.
#
# @import(../../)
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# Varlock keys environment-specific files on this item. `.env.test` loads when
# it is `test`. NODE_ENV stays with the tools that define it — node, Vite and
# Medusa each give it their own meaning.
# @type=enum(development, test, build, production)
APP_ENV=development

# --- Secrets ----------------------------------------------------------------

# @required @sensitive @type=string(startsWith=sk_)
STRIPE_API_KEY=

# @required @sensitive
JWT_SECRET=supersecret

# @required @sensitive
COOKIE_SECRET=supersecret

# --- Portless ---------------------------------------------------------------

# The Portless development command sets this. Nothing else does.
# @optional
PORTLESS_URL=

# True only when a Portless tunnel is serving a development run.
# @type=boolean
PORTLESS_ACTIVE=if(isEmpty($PORTLESS_URL), false, eq($APP_ENV, development))

# --- CORS -------------------------------------------------------------------
#
# Medusa accepts each comma-separated entry as an absolute origin or as a
# slash-delimited regular expression. The Portless patterns take the second
# form, so a worktree label can vary inside the host name.

# @required @type=string(matches="/^(?:https?:\/\/\S+|\/.+\/)(?:,(?:https?:\/\/\S+|\/.+\/))*$/")
STORE_CORS=if($PORTLESS_ACTIVE, "/^https://(?:[a-z0-9-]+\.)?storefront\.mze-store\.localhost$/", "http://localhost:3001")

# @required @type=string(matches="/^(?:https?:\/\/\S+|\/.+\/)(?:,(?:https?:\/\/\S+|\/.+\/))*$/")
ADMIN_CORS=if($PORTLESS_ACTIVE, "/^https://medusa\.mze-store\.localhost$/", "http://localhost:9000")

# @required @type=string(matches="/^(?:https?:\/\/\S+|\/.+\/)(?:,(?:https?:\/\/\S+|\/.+\/))*$/")
AUTH_CORS=if($PORTLESS_ACTIVE, "/^https://(?:[a-z0-9-]+\.)?storefront\.mze-store\.localhost$/,/^https://medusa\.mze-store\.localhost$/", "http://localhost:3001,http://localhost:9000")
