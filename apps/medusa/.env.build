# Committed on purpose, and loaded only when APP_ENV=build.
#
# `medusa build` evaluates medusa-config.ts, which reads every value. A build
# produces no connections and calls no APIs, so these placeholders let the
# build run without a database, a Redis, or a real Stripe key. Validation stays
# on — the schema still checks each value, and `ENV.X` still types as `string`.
#
# Nothing here is a secret. Anything that looks like one is a placeholder.

DB_PORT=5432
DB_PASSWORD=build-placeholder
REDIS_PORT=6379

STRIPE_API_KEY=sk_build_placeholder
JWT_SECRET=build-placeholder
COOKIE_SECRET=build-placeholder
