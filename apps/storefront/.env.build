# Committed on purpose, and loaded only when APP_ENV=build.
#
# The client build inlines the public values and resolves the rest at boot. A
# build reaches no database, so these placeholders stand in for the discovered
# PostgreSQL and Redis parts. Validation stays on.
#
# Nothing here is a secret. Anything that looks like one is a placeholder.

DB_PORT=5432
DB_PASSWORD=build-placeholder
REDIS_PORT=6379

BETTER_AUTH_SECRET=build-placeholder-secret-32-characters-x
