# Storefront contract. The Account service runs inside this process, so this
# schema is a superset of packages/auth/.env.schema.
#
# @import(../../)
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# @type=enum(development, test, build, production)
APP_ENV=development

# The Portless development command sets this. Nothing else does. Typed as a
# URL because two url-typed items resolve to it — an untyped value flowing
# into them would surface a malformed tunnel address at the wrong item.
# @optional @type=url
PORTLESS_URL=

# @type=boolean
PORTLESS_ACTIVE=if(isEmpty($PORTLESS_URL), false, eq($APP_ENV, development))

# --- Account service --------------------------------------------------------

# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=local-development-auth-secret-32-characters

# Under Portless the browser reaches the Storefront over its tunnel host, so
# the Account service has to sign and trust that origin rather than the port.
# @required @type=url
BETTER_AUTH_URL=if($PORTLESS_ACTIVE, $PORTLESS_URL, "http://localhost:3001")

# @required @type=url
CORS_ORIGIN=if($PORTLESS_ACTIVE, $PORTLESS_URL, "http://localhost:3001")
