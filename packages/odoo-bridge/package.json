      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.mts",
        "default": "./dist/effect.mjs"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    },
    "./promise": {
      "import": {
        "types": "./dist/promise.d.mts",
        "default": "./dist/promise.mjs"
      },
      "require": {
        "types": "./dist/promise.d.cts",
        "default": "./dist/promise.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    }
