{
  "name": "@mze-store/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": {
      "types": "./dist/src/lib/*.d.ts",
      "development": "./src/lib/*.ts",
      "node": "./dist/src/lib/*.js",
      "default": "./src/lib/*.ts"
    },
    "./components/*": {
      "types": "./dist/src/components/*.d.ts",
      "development": "./src/components/*.tsx",
      "node": "./dist/src/components/*.js",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "types": "./dist/src/hooks/*.d.ts",
      "development": "./src/hooks/*.ts",
      "node": "./dist/src/hooks/*.js",
      "default": "./src/hooks/*.ts"
    },
    "./postcss.config": "./postcss.config.mjs"
  },
  "scripts": {
    "build": "tsc -b && tsc-alias -p tsconfig.json",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.12.0",
    "sonner": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mze-store/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
