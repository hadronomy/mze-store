{
  "extends": "@mze-store/config/tsconfig.esm.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    // `vp pack` emits, and it resolves the ~/ alias while it does. tsc only checks.
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"],
      // The shadcn CLI resolves the aliases in components.json through here.
      "@mze-store/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
