{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "ESM preset for the storefront and every shared package. Anything the Medusa backend imports must emit CJS and cannot use this — see docs/adr/0012.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
