# Account service contract.
#
# This package never runs a process of its own — the Storefront hosts it, and
# the Storefront's varlock run supplies these values. The schema exists to type
# the reads in src/instance.ts. Keep it a strict subset of
# apps/storefront/.env.schema: an item declared here and missing there compiles
# and then fails at run time.
#
# @import(../../)
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=local-development-auth-secret-32-characters

# @required @type=url
BETTER_AUTH_URL=http://localhost:3001

# @required @type=url
CORS_ORIGIN=http://localhost:3001
