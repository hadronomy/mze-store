{
  "name": "@mze-store/auth",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "node": "./dist/src/index.js",
      "default": "./src/index.ts"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "development": "./auth.ts",
      "node": "./dist/auth.js",
      "default": "./auth.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "development": "./src/*.ts",
      "node": "./dist/src/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "auth:schema": "auth generate --config auth.ts --output ../db/src/schema/auth.ts --yes",
    "test": "vp run build && vp test --dir src && vp test --dir test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@mze-store/db": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@mze-store/config": "workspace:*",
    "auth": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:",
    "varlock": "1.16.1"
  }
}
