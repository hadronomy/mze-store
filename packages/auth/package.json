{
  "name": "@mze-store/auth",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "node": "./dist/src/index.js",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "development": "./src/*.ts",
      "node": "./dist/src/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "auth:schema": "auth generate --config auth.ts --output ../db/src/schema/auth.ts --yes",
    "build": "tsc -b && tsc-alias -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "vp test --dir src"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@mze-store/db": "workspace:*",
    "@mze-store/env": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@mze-store/config": "workspace:*",
    "auth": "catalog:",
    "typescript": "catalog:"
  }
}
