        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./email": {
      "import": {
        "types": "./dist/email.d.mts",
        "default": "./dist/email.mjs"
      },
      "require": {
        "types": "./dist/email.d.cts",
        "default": "./dist/email.cjs"
      }
    },
    "./theme.css": "./dist/theme.css",
    "./brand/icon.svg": "./brand/icon.svg",
    "./brand/mandala.svg": "./brand/mandala.svg"
  },
  "scripts": {
    "test": "vp run build && vp test --dir test"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@mze-store/config": "workspace:*",
    "@types/culori": "^4.0.1",
    "@types/node": "catalog:",
    "culori": "^4.0.2",
    "effect": "4.0.0-beta.107",
    "lightningcss": "^1.33.0",
    "typescript": "catalog:"
  }
