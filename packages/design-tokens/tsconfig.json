{
  "extends": "@mze-store/config/tsconfig.esm.json",
  "compilerOptions": {
    // The build script runs under node's native type stripping, which needs
    // explicit `.ts` specifiers. `erasableSyntaxOnly` is the other half of that
    // bargain: it rejects syntax node cannot strip, so the script fails to
    // typecheck rather than at run time. tsc only checks here — `vp pack` emits.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "exclude": ["dist", "vite.config.ts"]
}
