{
  "name": "@mze-store/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "node": "./dist/src/index.js",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "development": "./src/*.ts",
      "node": "./dist/src/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "vp run @mze-store/env#build && drizzle-kit push",
    "db:generate": "vp run @mze-store/env#build && drizzle-kit generate",
    "db:studio": "vp run @mze-store/env#build && drizzle-kit studio",
    "db:migrate": "vp run @mze-store/env#build && drizzle-kit migrate"
  },
  "dependencies": {
    "@mze-store/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@mze-store/config": "workspace:*",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
