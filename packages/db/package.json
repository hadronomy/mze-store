{
  "name": "@mze-store/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "node": "./dist/src/index.js",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/src/schema/index.d.ts",
      "development": "./src/schema/index.ts",
      "node": "./dist/src/schema/index.js",
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "development": "./src/*.ts",
      "node": "./dist/src/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "varlock run -- drizzle-kit push",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:studio": "varlock run -- drizzle-kit studio",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "test": "vp run build && vp test --dir test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@mze-store/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "varlock": "1.16.1"
  }
}
