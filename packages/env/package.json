{
  "name": "@mze-store/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./database": {
      "import": {
        "types": "./dist/database.d.mts",
        "default": "./dist/database.mjs"
      },
      "require": {
        "types": "./dist/database.d.cts",
        "default": "./dist/database.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./medusa": {
      "import": {
        "types": "./dist/medusa.d.mts",
        "default": "./dist/medusa.mjs"
      },
      "require": {
        "types": "./dist/medusa.d.cts",
        "default": "./dist/medusa.cjs"
      }
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check-types": "tsc --noEmit",
    "test": "vp run build && vp test --dir test"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mze-store/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
