{
  "name": "mze-store",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/node": "^24.10.1",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "vite-plus": "0.2.6",
      "@tanstack/react-router": "^1.170.18",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/react-router-ssr-query": "^1.167.1",
      "@tanstack/react-start": "^1.168.32",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-query-devtools": "^5.101.4",
      "@tanstack/react-form": "^1.33.0",
      "@medusajs/medusa": "2.18.0",
      "@medusajs/framework": "2.18.0",
      "@medusajs/cli": "2.18.0",
      "@medusajs/admin-sdk": "2.18.0",
      "@medusajs/admin-shared": "2.18.0",
      "@medusajs/dashboard": "2.18.0",
      "@medusajs/draft-order": "2.18.0",
      "@medusajs/icons": "2.18.0",
      "@medusajs/js-sdk": "2.18.0",
      "@medusajs/types": "2.18.0",
      "@medusajs/test-utils": "2.18.0",
      "@medusajs/ui": "4.2.0",
      "ts-node": "10.9.2",
      "@swc/core": "1.5.7",
      "ioredis": "5.11.1",
      "better-auth": "1.7.0-rc.4",
      "@better-auth/drizzle-adapter": "1.7.0-rc.4",
      "auth": "1.7.0-rc.4",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run @mze-store/env#build && vp run -r dev:raw",
    "dev:portless": "bun run portless:check && vp run @mze-store/env#build && vp run -r dev:portless:raw",
    "dev:portless:storefront": "bun run portless:check && vp run @mze-store/env#build && vp run --filter storefront dev:portless:raw",
    "portless:check": "node tooling/portless/check.mjs",
    "services:start": "docker compose up -d postgres redis",
    "services:stop": "docker compose stop postgres redis",
    "build": "vp run -r build",
    "build:packages": "vp run @mze-store/env#build && vp run --filter @mze-store/db build && vp run --filter @mze-store/auth build && vp run --filter @mze-store/ui build",
    "check-types": "bun run build:packages && vp run --filter './apps/*' --filter './packages/*' check-types",
    "test": "vp test && vp run --filter medusa test",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:storefront": "vp run @mze-store/env#build && vp run --filter storefront dev:raw",
    "db:push": "vp run --filter @mze-store/db db:push",
    "db:studio": "vp run --filter @mze-store/db db:studio",
    "db:generate": "vp run --filter @mze-store/db db:generate",
    "db:migrate": "vp run --filter @mze-store/db db:migrate",
    "auth:schema": "vp run @mze-store/env#build && vp run --filter @mze-store/db build && vp run --filter @mze-store/auth auth:schema && vp fmt --write packages/db/src/schema/auth.ts",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@mze-store/config": "workspace:*",
    "@oxlint/plugins": "1.73.0",
    "@types/node": "catalog:",
    "rolldown": "1.1.4",
    "tsc-alias": "^1.9.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.14"
}
